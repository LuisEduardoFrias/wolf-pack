{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node 22",
  "_version": "22.0.0",
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "module": "node16",
    "rootDir": "./src", // Cambia esto
    "moduleResolution": "node16",
    "baseUrl": "./",
    "paths": {
      "guid-typescript": [
        "node_modules/guid-typescript/dist/guid.d.ts"
      ]
    },
    "typeRoots": [
      "node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "resolveJsonModule": false,
    "outDir": "./dist",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "declaration": true
  },
  "exclude": [
    "test.ts",
    "test/",
    "DATA/"
  ]
}